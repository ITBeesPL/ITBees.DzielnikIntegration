<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ITBees.DzielnikIntegration.Fas</PackageId>
    <Version>8.0.2</Version>
    <Authors>ITBees</Authors>
    <Description>Dzielnik.com invoicing bridge for the ITBees.FAS payment stack: automatically creates a Dzielnik sales invoice (with buyer e-mail) for every successfully paid PaymentSession via the ISuccessfulPaymentInvoiceIssuer hook and a background worker, offers an idempotent monthly catch-up run, and optionally submits invoices to KSeF through Dzielnik. Ships the /DzielnikMonthlyInvoices controller, the outbox entity and EF model registration.</Description>
    <PackageTags>dzielnik;fas;stripe;invoicing;ksef;faktura</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITBees.DzielnikIntegration\ITBees.DzielnikIntegration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ITBees.FAS.Payments" Version="8.0.351" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.10" />
  </ItemGroup>

</Project>
